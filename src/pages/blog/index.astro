---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import BlogCard from '../../components/BlogCard.astro';
import CtaSection from '../../components/CtaSection.astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: 'Blog' }
];

const pageTitle = 'Blog Souvenir Kantor — Tips, Ide & Panduan Pengadaan';
const pageDesc = 'Panduan memilih souvenir kantor, isi seminar kit ideal, ide merchandise acara perusahaan, dan SOP pemesanan custom logo dari Seminarkit.';
---

<BaseLayout title={pageTitle} description={pageDesc} breadcrumbs={breadcrumbs}>
  <PageBanner
    title="Blog & Panduan Pengadaan"
    description="Wawasan praktis, tips pemilihan material, dan panduan pengadaan souvenir kantor serta merchandise korporat."
    breadcrumb={breadcrumbs}
  />

  <section class="section section-cream-50">
    <div class="container">
      <div class="blog-grid">
        {sortedPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaSection
    title="Ingin Konsultasi Konsep Souvenir untuk Acara Anda?"
    description="Diskusikan konsep desain dan kebutuhan anggaran souvenir kantor bersama tim spesialis Seminarkit."
    buttonText="Konsultasi via WhatsApp"
    source="blog-index-cta"
  />
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 36px;
  }

  @media (max-width: 900px) {
    .blog-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>
