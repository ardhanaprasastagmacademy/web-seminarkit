---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import { waLink } from '../utils/wa.js';

const breadcrumbs = [
  { label: 'Beranda', href: '/' },
  { label: '404' }
];

const waHelpUrl = waLink('Halo Seminarkit, saya mencari halaman tertentu di website yang tidak ditemukan.', '404');
---

<BaseLayout
  title="404 — Halaman Tidak Ditemukan | Seminarkit"
  description="Halaman yang Anda tuju tidak ditemukan atau telah dipindahkan."
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <PageBanner
    title="Halaman Tidak Ditemukan (404)"
    breadcrumb={breadcrumbs}
  />

  <section class="section section-cream-100 not-found-section">
    <div class="container not-found-container">
      <span class="not-found-num">404</span>
      <h2 class="not-found-title">Maaf, Halaman yang Anda Cari Tidak Tersedia</h2>
      <p class="not-found-desc">
        Tautan yang Anda ikuti mungkin salah ketik, sudah diperbarui, atau halaman tersebut telah dipindahkan ke tautan baru.
      </p>

      <div class="not-found-actions">
        <a href="/" class="btn btn-primary">
          Kembali ke Beranda
        </a>
        <a href="/produk/" class="btn btn-secondary">
          Lihat Katalog Produk
        </a>
        <a
          href={waHelpUrl}
          class="btn btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Hubungi Tim via WA
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found-container {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40px 24px;
  }

  .not-found-num {
    font-family: var(--font-display);
    font-size: 96px;
    font-weight: 600;
    color: var(--brass);
    line-height: 1;
    margin-bottom: 16px;
  }

  .not-found-title {
    font-size: 32px;
    font-weight: 500;
    margin-bottom: 16px;
    color: var(--navy-700);
  }

  .not-found-desc {
    font-size: 16px;
    line-height: 1.65;
    color: var(--ink-soft);
    margin-bottom: 36px;
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .not-found-num {
      font-size: 72px;
    }

    .not-found-title {
      font-size: 26px;
    }

    .not-found-actions {
      flex-direction: column;
      width: 100%;
    }

    .not-found-actions .btn {
      width: 100%;
    }
  }
</style>

