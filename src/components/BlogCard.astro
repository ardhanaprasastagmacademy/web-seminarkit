---
import { Image } from 'astro:assets';

interface Props {
  post: {
    id?: string;
    slug?: string;
    data: {
      title: string;
      description: string;
      date: Date;
      author: string;
      image: ImageMetadata;
      imageAlt: string;
    };
  };
}

const { post } = Astro.props;
const slug = post.slug || post.id?.replace(/\.md$/, '') || '';

const formattedDate = new Intl.DateTimeFormat('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
}).format(new Date(post.data.date));
---

<article class="blog-card card-base">
  <a href={`/blog/${slug}/`} class="blog-card-link">
    <div class="blog-image-wrap">
      <Image
        src={post.data.image}
        alt={post.data.imageAlt}
        width={600}
        height={400}
        class="blog-image"
        loading="lazy"
      />
    </div>

    <div class="blog-body">
      <div class="blog-meta">
        <time datetime={new Date(post.data.date).toISOString()}>{formattedDate}</time>
        <span class="meta-sep" aria-hidden="true">/</span>
        <span>{post.data.author}</span>
      </div>

      <h3 class="blog-title">{post.data.title}</h3>

      <p class="blog-desc">{post.data.description}</p>

      <span class="blog-read-link">Baca artikel</span>
    </div>
  </a>
</article>

<style>
  .blog-card {
    height: 100%;
    transition: border-color 200ms var(--ease);
  }

  .blog-card:hover {
    border-color: var(--navy-500);
  }

  .blog-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }

  .blog-image-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background-color: var(--cream-100);
    border-bottom: 1px solid var(--cream-300);
  }

  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .blog-card:hover .blog-image {
    transform: scale(1.03);
  }

  .blog-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .blog-meta {
    font-size: 13px;
    color: var(--ink-soft);
    margin-bottom: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .meta-sep {
    opacity: 0.5;
  }

  .blog-title {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 12px;
    color: var(--ink);
    transition: color 150ms var(--ease);
  }

  .blog-card:hover .blog-title {
    color: var(--navy-700);
  }

  .blog-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .blog-read-link {
    margin-top: auto;
    font-size: 14px;
    font-weight: 500;
    color: var(--navy-700);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

