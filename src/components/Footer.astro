---
import { siteConfig } from '../data/site.js';
import { products } from '../data/products.js';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Bio -->
      <div class="footer-col col-brand">
        <span class="footer-logo">Seminarkit</span>
        <p class="footer-desc">
          Vendor souvenir kantor, paket seminar kit, dan merchandise perusahaan terpercaya. Menghadirkan produk berkualitas dengan pengerjaan rapi dan pengiriman aman ke seluruh Indonesia.
        </p>
        <p class="footer-area">
          <strong>Wilayah Layanan:</strong> {siteConfig.serviceArea}
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="footer-col">
        <h4 class="footer-heading">Navigasi</h4>
        <ul class="footer-links">
          <li><a href="/" class="footer-link">Beranda</a></li>
          <li><a href="/tentang/" class="footer-link">Tentang Kami</a></li>
          <li><a href="/produk/" class="footer-link">Katalog Produk</a></li>
          <li><a href="/blog/" class="footer-link">Blog & Artikel</a></li>
          <li><a href="/galeri/" class="footer-link">Galeri Portofolio</a></li>
          <li><a href="/faq/" class="footer-link">Tanya Jawab (FAQ)</a></li>
          <li><a href="/kontak/" class="footer-link">Kontak & Pemesanan</a></li>
        </ul>
      </div>

      <!-- Col 3: Products -->
      <div class="footer-col">
        <h4 class="footer-heading">Produk Unggulan</h4>
        <ul class="footer-links">
          {products.map((p) => (
            <li>
              <a href={`/produk/${p.slug}/`} class="footer-link">
                {p.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact & Hours -->
      <div class="footer-col">
        <h4 class="footer-heading">Kontak & Operasional</h4>
        <div class="footer-contact">
          <p>
            <strong>WhatsApp:</strong><br />
            <a href={siteConfig.waUrl} class="footer-contact-link" target="_blank" rel="noopener noreferrer">
              {siteConfig.waDisplay}
            </a>
          </p>
          <p>
            <strong>Email:</strong><br />
            <a href={`mailto:${siteConfig.email}`} class="footer-contact-link">
              {siteConfig.email}
            </a>
          </p>
          <p>
            <strong>Alamat:</strong><br />
            <span>{siteConfig.address.full}</span>
          </p>
          <p>
            <strong>Jam Operasional:</strong><br />
            <span>{siteConfig.operatingHours}</span>
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} {siteConfig.name}. Seluruh hak cipta dilindungi undang-undang.
      </p>
      <div class="legal-links">
        <a href="/kebijakan-privasi/" class="legal-link">Kebijakan Privasi</a>
        <span class="sep">/</span>
        <a href="/syarat-ketentuan/" class="legal-link">Syarat & Ketentuan</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--navy-900);
    color: var(--cream-100);
    padding-top: 80px;
    padding-bottom: 40px;
    margin-top: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1.5fr 1.5fr;
    gap: 48px;
    padding-bottom: 64px;
    border-bottom: 1px solid rgba(255, 248, 220, 0.14);
  }

  .footer-logo {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 600;
    color: var(--cream-100);
    display: block;
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .footer-desc {
    color: rgba(255, 248, 220, 0.72);
    font-size: 14px;
    line-height: 1.6;
    margin-bottom: 16px;
  }

  .footer-area {
    font-size: 13px;
    color: rgba(255, 248, 220, 0.72);
  }

  .footer-heading {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--cream-100);
    margin-bottom: 20px;
  }

  .footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .footer-link {
    color: rgba(255, 248, 220, 0.72);
    font-size: 14px;
    text-decoration: none;
    transition: color 150ms var(--ease);
  }

  .footer-link:hover {
    color: var(--cream-100);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-size: 14px;
    color: rgba(255, 248, 220, 0.72);
  }

  .footer-contact-link {
    color: var(--cream-100);
    text-decoration: none;
  }

  .footer-contact-link:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    padding-top: 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: rgba(255, 248, 220, 0.6);
  }

  .legal-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .legal-link {
    color: rgba(255, 248, 220, 0.6);
    text-decoration: none;
  }

  .legal-link:hover {
    color: var(--cream-100);
  }

  .sep {
    opacity: 0.4;
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 36px;
      padding-bottom: 48px;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>

