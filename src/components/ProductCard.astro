---
import { Image } from 'astro:assets';
import { waLink } from '../utils/wa.js';

interface Props {
  product: {
    slug: string;
    name: string;
    shortDescription: string;
    price: string;
    priceUnit?: string;
    images: {
      main: ImageMetadata;
    };
  };
}

const { product } = Astro.props;

const productWaMsg = `Halo Seminarkit, saya ingin memesan produk "${product.name}". Mohon informasi katalog dan penawaran harganya.`;
const productWaUrl = waLink(productWaMsg, 'produk-card');
---

<article class="product-card card-base">
  <div class="product-image-wrap">
    <Image
      src={product.images.main}
      alt={`Foto produk ${product.name}`}
      width={600}
      height={750}
      class="product-image"
      loading="lazy"
    />
  </div>

  <div class="product-body">
    <h3 class="product-title">
      <a href={`/produk/${product.slug}/`} class="product-title-link">
        {product.name}
      </a>
    </h3>

    <p class="product-desc">{product.shortDescription}</p>

    <div class="product-price-row">
      <span class="price-val">{product.price}</span>
      {product.priceUnit && <span class="price-unit">/{product.priceUnit.replace(/^per\s+/i, '')}</span>}
    </div>

    <div class="product-actions">
      <a href={`/produk/${product.slug}/`} class="btn btn-secondary btn-sm btn-product">
        Detail produk
      </a>
      <a
        href={productWaUrl}
        class="btn btn-primary btn-sm btn-product"
        data-wa-source="produk-card"
        aria-label={`Pesan ${product.name} via WhatsApp`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Pesan WA
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .product-image-wrap {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background-color: var(--cream-100);
    border-bottom: 1px solid var(--cream-300);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .product-card:hover .product-image {
    transform: scale(1.03);
  }

  .product-body {
    padding: 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 12px;
  }

  .product-title-link {
    color: var(--ink);
    text-decoration: none;
    transition: color 150ms var(--ease);
  }

  .product-title-link:hover {
    color: var(--navy-700);
  }

  .product-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-bottom: 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-price-row {
    margin-top: auto;
    margin-bottom: 20px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .price-val {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--navy-700);
  }

  .price-unit {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .product-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .btn-product {
    width: 100%;
    padding: 12px 14px;
  }
</style>

