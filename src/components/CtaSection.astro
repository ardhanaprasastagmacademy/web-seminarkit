---
import { waLink } from '../utils/wa.js';

interface Props {
  title?: string;
  description?: string;
  buttonText?: string;
  buttonLink?: string;
  source?: string;
}

const {
  title = 'Siap Menyiapkan Souvenir Kantor & Seminar Kit Anda?',
  description = 'Konsultasikan kebutuhan desain logo, estimasi kuantitas, dan jadwal pengiriman langsung bersama tim representatif kami.',
  buttonText = 'Konsultasi via WhatsApp',
  buttonLink,
  source = 'cta-section'
} = Astro.props;

const finalLink = buttonLink || waLink('Halo Seminarkit, saya ingin berkonsultasi mengenai pemesanan souvenir kantor.', source);
---

<section class="section section-dark cta-section">
  <div class="container cta-container">
    <div class="cta-content">
      <h2 class="cta-title">{title}</h2>
      <p class="cta-desc">{description}</p>
      <div class="cta-action">
        <a
          href={finalLink}
          class="btn btn-primary-invert"
          data-wa-source={source}
          target="_blank"
          rel="noopener noreferrer"
        >
          {buttonText}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    border-top: 1px solid rgba(255, 248, 220, 0.12);
    border-bottom: 1px solid rgba(255, 248, 220, 0.12);
  }

  .cta-container {
    display: flex;
    justify-content: center;
  }

  .cta-content {
    max-width: 680px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-title {
    font-size: 40px;
    font-weight: 500;
    line-height: 1.15;
    color: var(--cream-100);
    margin-bottom: 16px;
  }

  .cta-desc {
    font-size: 17px;
    line-height: 1.7;
    color: rgba(255, 248, 220, 0.85);
    margin-bottom: 36px;
    max-width: 58ch;
  }

  .cta-action {
    display: flex;
    justify-content: center;
  }

  @media (max-width: 900px) {
    .cta-title {
      font-size: 30px;
    }

    .cta-desc {
      font-size: 16px;
      margin-bottom: 28px;
    }
  }
</style>

