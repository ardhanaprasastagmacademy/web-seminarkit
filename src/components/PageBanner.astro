---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  breadcrumb: BreadcrumbItem[];
}

const { title, description, breadcrumb } = Astro.props;
---

<div class="page-banner">
  <div class="container banner-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        {breadcrumb.map((item, index) => {
          const isLast = index === breadcrumb.length - 1;
          return (
            <li class="breadcrumb-item">
              {item.href && !isLast ? (
                <a href={item.href} class="breadcrumb-link">
                  {item.label}
                </a>
              ) : (
                <span class="breadcrumb-current" aria-current="page">
                  {item.label}
                </span>
              )}
              {!isLast && <span class="breadcrumb-sep" aria-hidden="true">/</span>}
            </li>
          );
        })}
      </ol>
    </nav>

    <!-- Page Title -->
    <h1 class="banner-title">{title}</h1>
    {description && <p class="banner-desc">{description}</p>}
  </div>
</div>

<style>
  .page-banner {
    background-color: var(--navy-700);
    color: var(--cream-100);
    min-height: 240px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255, 248, 220, 0.12);
    padding: 40px 0;
  }

  .banner-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .breadcrumb-nav {
    margin-bottom: 16px;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: rgba(255, 248, 220, 0.7);
  }

  .breadcrumb-item {
    display: inline-flex;
    align-items: center;
  }

  .breadcrumb-link {
    color: rgba(255, 248, 220, 0.7);
    text-decoration: none;
    transition: color 150ms var(--ease);
  }

  .breadcrumb-link:hover {
    color: var(--cream-100);
  }

  .breadcrumb-sep {
    margin: 0 10px;
    opacity: 0.5;
  }

  .breadcrumb-current {
    color: var(--cream-100);
    font-weight: 700;
  }

  .banner-title {
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 600;
    line-height: 1.1;
    color: var(--cream-100);
    margin: 0;
  }

  .banner-desc {
    margin-top: 12px;
    font-size: 17px;
    color: rgba(255, 248, 220, 0.85);
    max-width: 60ch;
  }

  @media (max-width: 900px) {
    .page-banner {
      min-height: 200px;
      padding: 32px 0;
    }

    .banner-title {
      font-size: 34px;
    }

    .banner-desc {
      font-size: 15px;
    }
  }
</style>

